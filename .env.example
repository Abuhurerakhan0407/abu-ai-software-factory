# Core runtime. Never commit real values.
DATABASE_URL=postgresql://user:password@host/database
FACTORY_API_TOKEN=replace_with_a_long_random_secret_never_commit
OPENROUTER_API_KEY=replace_locally_never_commit
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GITHUB_CONNECTOR_ID=replace_with_vercel_connect_configuration_id

# Use an explicit provider model for production readiness.
MISSION_CONTROL_MODEL=google/gemma-4-26b-a4b-it:free
# Optional independent worker model:
# EXECUTION_AGENT_MODEL=google/gemma-4-26b-a4b-it:free

# Separate human production-approval channel.
FACTORY_APPROVAL_TOKEN=replace_with_a_different_long_random_secret

# Production deployment monitoring and rollback.
VERCEL_AUTOMATION_TOKEN=replace_locally_never_commit
VERCEL_TEAM_ID=replace_with_vercel_team_id
